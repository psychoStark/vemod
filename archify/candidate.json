  "cards": [
    {
      "dot": "cyan",
      "title": "Multi-APK Ingestion & System Integration",
      "items": [
        "Dynamic Multi-Archive Ingestion: Unpacks .apk, .xapk, .apks, and .zip archives, extracting 32-bit ELF binaries to lib32/ and OBB expansions to container directories.",
        "Micro-Stub Companion APKs (~25 KB): Synthesizes standalone signed 64-bit packages with authentic guest branding, AXML/ARSC string rewriting, and Android 15/16 SDK 35 targets for native App Drawer integration.",
        "Home Screen Pinning: 1x1 pinned shortcuts via ShortcutManagerCompat with high-res extracted icons and decoupled task affinity.",
        "StartingWindow Suppression: Translucent theme eliminates placeholder blueprint robot splashes before in-process dynamic overlay renders."
      ]
    },
    {
      "dot": "emerald",
      "title": "Multi-Process Isolation & Runtime Virtualization",
      "items": [
        "5 Dedicated Isolated Processes (:guest1..:guest5): Dynamic slot allocator prevents memory arena collisions, GLES state interleaving, and Bionic global state conflicts.",
        "Context & Storage Virtualization: Swaps mBase with GuestContext, redirecting data and database paths into private container storage or public exposed storage (/sdcard/vemod/).",
        "High-Refresh-Rate Touch Pacing (TouchPacer): Transparent Window.Callback proxy paces sub-60ms ACTION_UP events across distinct render ticks on 120Hz/240Hz screens, restoring instant single-tap responsiveness in decoupled game engines.",
        "AttributionSource AudioTrack Virtualization: Dynamically inspects call stacks to forward host package UID permissions, restoring background music and sound effects across modern Android 12-16 frameworks.",
        "Defunct SDK & GMS Neutralizer: Neutralizes defunct ad networks (AdColony, Chartboost, Flurry, AdMob), forces Google Play GameHelper to STATE_CONNECTING, and intercepts unhandled exceptions to prevent main Looper termination."
      ]
    },
    {
      "dot": "violet",
      "title": "Native Bridge & Dynarmic ARM32 JIT Engine",
      "items": [
        "Dynamic Multi-Module Linker: Isolated g_modules symbol tables resolve CFFI duplicate symbol collisions (Haxe/Lime); built-in SLEB128 decoder unpacks packed relocations (APS2) resolving all 2,199 symbols in libc++.so.",
        "4 GB Virtual Memory Arena: Private mmap at fixed address (0x100000000ULL) emulates 32-bit pointers with guest heap brk management.",
        "Cycle-Guarded IR Identity Traversal: Replaced recursive IR identity inspection with bounded iterative traversal (depth <= 32) and cycle checks, eliminating fatal SIGSEGV call stack overflows during JIT optimization passes.",
        "Persistent Block Cache (.vcache): Automated eglSwapBuffers frame-based hot-block profiling compiles JIT code blocks ahead-of-time on subsequent launches, locking gameplay at smooth 60 FPS."
      ]
    },
    {
      "dot": "amber",
      "title": "Syscall Emulation & Hardware Acceleration",
      "items": [
        "125+ Kernel Syscall Surface: Emulates memory, timers, sockets, futex (with val3=0 bitset match normalization preventing Unity Boehm GC deadlocks), robust mutexes, and non-root sched_* priority fallback.",
        "Universal Epoll Event Marshaling: Converts 12-byte packed guest epoll_event to 16-byte host structures with strict 8-byte data alignment, preventing pointer corruption in asynchronous network threads.",
        "Filesystem & Path Redirection: Virtualizes /proc/self/exe to guest base.apk and redirects /data/local/tmp and /tmp into sandboxed container cache.",
        "Hardware Passthrough Bridges: 141+ OpenGL ES 2.0 functions, fixed-point GLES 1.1 with glTexParameterx texture filtering, 32-bit safe shadow buffer mapping for VBOs, and OpenSL ES 1.0.1 audio with dynamic .bss UUID resolution."
      ]
    }
  ]
