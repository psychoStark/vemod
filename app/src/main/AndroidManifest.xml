<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackages" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!-- microG Extended Access & Impersonation permissions -->
    <uses-permission android:name="app.revanced.gms.EXTENDED_ACCESS" />
    <uses-permission android:name="org.microg.gms.EXTENDED_ACCESS" />
    <uses-permission android:name="app.revanced.android.googleapps.permission.GOOGLE_AUTH.local" />
    <uses-permission android:name="app.revanced.android.googleapps.permission.GOOGLE_AUTH.mail" />
    <uses-permission android:name="app.revanced.android.googleapps.permission.GOOGLE_AUTH.cp" />
    <uses-permission android:name="app.revanced.android.googleapps.permission.GOOGLE_AUTH.writely" />
    <uses-permission android:name="app.revanced.android.providers.gsf.permission.READ_GSERVICES" />
    <uses-permission android:name="com.google.android.providers.gsf.permission.READ_GSERVICES" />
    <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="app.revanced.android.gms.permission.ACTIVITY_RECOGNITION" />

    <queries>
        <package android:name="com.google.android.gms" />
        <package android:name="app.revanced.android.gms" />
        <package android:name="com.mgoogle.android.gms" />
        <package android:name="org.microg.gms.core" />
        <package android:name="com.android.vending" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DELETE" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="com.google.android.gms.actions.SEARCH_ACTION" />
        </intent>
    </queries>

    <application
        android:name=".VemodApp"
        android:allowBackup="true"
        android:label="Vemod"
        android:icon="@mipmap/ic_vemod_launcher"
        android:roundIcon="@mipmap/ic_vemod_launcher_round"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <uses-library android:name="org.apache.http.legacy" android:required="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.xapk" />
                <data android:pathPattern=".*\\.apks" />
            </intent-filter>
        </activity>

        <!-- Router Activity (translucent, no preview) -->
        <activity
            android:name=".proxy.GuestProxyActivity"
            android:theme="@style/Theme.Vemod.Router"
            android:exported="true"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|fontScale|layoutDirection" />

        <!-- Concurrent Isolated Guest Container Processes (1 to 5) -->
        <!-- Slot 1 -->
        <activity
            android:name=".proxy.GuestProxyActivity1"
            android:process=":guest1"
            android:taskAffinity="com.psychostark.vemod.task1"
            android:theme="@style/Theme.Vemod.Guest"
            android:exported="false"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|fontScale|layoutDirection" />
        <activity
            android:name=".proxy.GuestProxyActivity1P"
            android:process=":guest1"
            android:taskAffinity="com.psychostark.vemod.task1"
            android:theme="@style/Theme.Vemod.Guest"
            android:screenOrientation="portrait"
            android:exported="false"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|fontScale|layoutDirection" />
        <activity
            android:name=".proxy.GuestProxyActivity1L"
            android:process=":guest1"
            android:taskAffinity="com.psychostark.vemod.task1"
            android:theme="@style/Theme.Vemod.Guest"
            android:screenOrientation="sensorLandscape"
            android:exported="false"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|fontScale|layoutDirection" />

        <!-- Slot 2 -->
        <activity
            android:name=".proxy.GuestProxyActivity2"
            android:process=":guest2"
            android:taskAffinity="com.psychostark.vemod.task2"
            android:theme="@style/Theme.Vemod.Guest"
            android:exported="false"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|fontScale|layoutDirection" />
        <activity
            android:name=".proxy.GuestProxyActivity2P"
            android:process=":guest2"
            android:taskAffinity="com.psychostark.vemod.task2"
            android:theme="@style/Theme.Vemod.Guest"
            android:screenOrientation="portrait"
            android:exported="false"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|fontScale|layoutDirection" />
        <activity
            android:name=".proxy.GuestProxyActivity2L"
            android:process=":guest2"
            android:taskAffinity="com.psychostark.vemod.task2"
            android:theme="@style/Theme.Vemod.Guest"
            android:screenOrientation="sensorLandscape"
            android:exported="false"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|fontScale|layoutDirection" />

        <!-- Slot 3 -->
        <activity
            android:name=".proxy.GuestProxyActivity3"
            android:process=":guest3"
            android:taskAffinity="com.psychostark.vemod.task3"
            android:theme="@style/Theme.Vemod.Guest"
            android:exported="false"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|fontScale|layoutDirection" />
        <activity
            android:name=".proxy.GuestProxyActivity3P"
            android:process=":guest3"
            android:taskAffinity="com.psychostark.vemod.task3"
            android:theme="@style/Theme.Vemod.Guest"
            android:screenOrientation="portrait"
            android:exported="false"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|fontScale|layoutDirection" />
        <activity
            android:name=".proxy.GuestProxyActivity3L"
            android:process=":guest3"
            android:taskAffinity="com.psychostark.vemod.task3"
            android:theme="@style/Theme.Vemod.Guest"
            android:screenOrientation="sensorLandscape"
            android:exported="false"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|fontScale|layoutDirection" />

        <!-- Slot 4 -->
        <activity
            android:name=".proxy.GuestProxyActivity4"
            android:process=":guest4"
            android:taskAffinity="com.psychostark.vemod.task4"
            android:theme="@style/Theme.Vemod.Guest"
            android:exported="false"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|fontScale|layoutDirection" />
        <activity
            android:name=".proxy.GuestProxyActivity4P"
            android:process=":guest4"
            android:taskAffinity="com.psychostark.vemod.task4"
            android:theme="@style/Theme.Vemod.Guest"
            android:screenOrientation="portrait"
            android:exported="false"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|fontScale|layoutDirection" />
        <activity
            android:name=".proxy.GuestProxyActivity4L"
            android:process=":guest4"
            android:taskAffinity="com.psychostark.vemod.task4"
            android:theme="@style/Theme.Vemod.Guest"
            android:screenOrientation="sensorLandscape"
            android:exported="false"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|fontScale|layoutDirection" />

        <!-- Slot 5 -->
        <activity
            android:name=".proxy.GuestProxyActivity5"
            android:process=":guest5"
            android:taskAffinity="com.psychostark.vemod.task5"
            android:theme="@style/Theme.Vemod.Guest"
            android:exported="false"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|fontScale|layoutDirection" />
        <activity
            android:name=".proxy.GuestProxyActivity5P"
            android:process=":guest5"
            android:taskAffinity="com.psychostark.vemod.task5"
            android:theme="@style/Theme.Vemod.Guest"
            android:screenOrientation="portrait"
            android:exported="false"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|fontScale|layoutDirection" />
        <activity
            android:name=".proxy.GuestProxyActivity5L"
            android:process=":guest5"
            android:taskAffinity="com.psychostark.vemod.task5"
            android:theme="@style/Theme.Vemod.Guest"
            android:screenOrientation="sensorLandscape"
            android:exported="false"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|fontScale|layoutDirection" />

        <!-- FileProvider for installing generated stub APKs -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Receiver for PackageInstaller completion -->
        <receiver
            android:name=".container.StubInstallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.vemod.action.STUB_INSTALLED" />
                <action android:name="com.vemod.action.STUB_UNINSTALLED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
